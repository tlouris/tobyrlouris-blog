# Database Configuration
DATABASE_URL=mysql+pymysql://visitor_log_user:CHANGE_ME_PASSWORD@mysql:3306/visitor_log

# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# MySQL Database Name
MYSQL_DATABASE=visitor_log

# MySQL User Credentials
MYSQL_USER=visitor_log_user
MYSQL_PASSWORD=CHANGE_ME_PASSWORD

# Application Settings
APP_ENV=production
DEBUG=False

# Admin Credentials
# Generate password hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_BCRYPT_HASH
ADMIN_SESSION_TIMEOUT_MINUTES=120
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_HEX_STRING
